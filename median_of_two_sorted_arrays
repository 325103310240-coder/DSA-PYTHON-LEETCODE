class Solution(object):
    def findMedianSortedArrays(self, nums1, nums2):
        """
        :type nums1: List[int]
        :type nums2: List[int]
        :rtype: float
        """
        nums=nums1+nums2
        nums.sort()
        if len(nums)%2==0:
            mid1=(len(nums))//2
            mid2=mid1-1
            return (nums[mid1]+nums[mid2])/2.0
        else:
            mid=len(nums)//2
            return nums[mid]
        
