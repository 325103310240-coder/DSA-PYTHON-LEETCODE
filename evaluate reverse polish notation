class Solution(object):
    def evalRPN(self, tokens):
        """
        :type tokens: List[str]
        :rtype: int
        """
        self.evalRPN=[]
        
        for i in tokens:
            if i not in ["+",'-','*','/']:
                self.evalRPN.append(int(i))
            else:
                a=self.evalRPN.pop()
                b=self.evalRPN.pop()
                if i=='+':
                    res=(a+b)
                elif i=='-':
                    res=b-a
                elif i=='*':
                    res=(a*b)
                elif i=='/':
                    res=(abs(b)/abs(a))
                    if (b<0)!=(a<0):
                        res=-res
                self.evalRPN.append(res)
        return self.evalRPN.pop()
        Example 1:

Input: tokens = ["2","1","+","3","*"]
Output: 9
Explanation: ((2 + 1) * 3) = 9

        
