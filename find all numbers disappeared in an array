class Solution(object):
    def findDisappearedNumbers(self, nums):
        """
        :type nums: List[int]
        :rtype: List[int]
        """
        nums.sort()
        res=[]
        s=set(nums)
        for i in range(1,len(nums)+1):
            if i in s:
                continue
            else:
                res.append(i)
                

                
            
            
        
        return res
        Input: nums = [4,3,2,7,8,2,3,1]
Output: [5,6]
Example 2:

Input: nums = [1,1]
Output: [2]
